# ── Required ──────────────────────────────────────────────────────────
# Postgres connection string (omit for in-memory repository)
DATABASE_URL=postgres://optigate:optigate@localhost:5432/mcp_registry

# AES-256-GCM key for encrypting secrets at rest (min 32 chars)
SECRET_ENCRYPTION_KEY=

# ── Auth ─────────────────────────────────────────────────────────────
# Production: Keycloak JWT (RS256/JWKS)
# Dev:       AUTH_MODE=dev  → header-based identity, see README
AUTH_MODE=dev

# Keycloak issuer (only when AUTH_MODE != dev)
KEYCLOAK_URL=
KEYCLOAK_REALM=
# Optional: defaults to realm value
KEYCLOAK_AUDIENCE=

# ── Server ───────────────────────────────────────────────────────────
PORT=8100
APPROVAL_REQUIRED=false

# ── SSRF protection ──────────────────────────────────────────────────
# Comma-separated list of allowed hosts/globs (e.g. *.example.com,api.myservice.com).
# When set, ONLY listed hosts may be connected. When empty, all routable
# targets are allowed except loopback/private/link-local ranges.
# Note: hosts resolving to LAN IPs (e.g. via FritzBox DNS) must be listed here.
SSRF_ALLOWED_HOSTS=
# Home-lab escape hatch: also allow loopback/private/link-local targets.
# Default false. Same effect at runtime via the ssrf.allowPrivateRanges setting.
SSRF_ALLOW_PRIVATE_RANGES=false

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins (default: all origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3030

# ── Connection pool ──────────────────────────────────────────────────
MAX_CONNS_PER_SERVER=20

# ── Runtime tuning (all also changeable live in the UI: Settings view) ─
# Global rate limit (requests/minute/IP)
RATE_LIMIT_MAX=200
# Tool index refresh interval / retry delay (ms), stale cycles until drop
RECONCILE_INTERVAL_MS=60000
RECONCILE_RETRY_MS=5000
RECONCILE_MAX_STALE=10
# Tool retrieval: default and max top-k
SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=20
# Audit feed length
AUDIT_LIMIT=100
# Per-request timeout of the /mcp gateway (ms)
GATEWAY_DISPATCH_TIMEOUT_MS=30000