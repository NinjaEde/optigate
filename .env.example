# ── Required ──────────────────────────────────────────────────────────
# Postgres connection string (omit for in-memory repository)
DATABASE_URL=postgres://optigate:optigate@localhost:5432/mcp_registry

# AES-256-GCM key for encrypting secrets at rest (min 32 chars)
SECRET_ENCRYPTION_KEY=

# ── Auth ─────────────────────────────────────────────────────────────
# Production: Keycloak JWT (RS256/JWKS)
# Dev:       AUTH_MODE=dev    → header-based identity, see README
# Local:     AUTH_MODE=local  → username/password login, no Keycloak needed
AUTH_MODE=dev

# Keycloak issuer (only when AUTH_MODE=keycloak, the default)
KEYCLOAK_URL=
KEYCLOAK_REALM=
# Optional: defaults to realm value
KEYCLOAK_AUDIENCE=

# Local auth (only when AUTH_MODE=local)
# HS256 signing secret for session JWTs (required, min 32 chars)
LOCAL_JWT_SECRET=
# Session lifetime: 12h, 30m, 7d, 900s or plain milliseconds (default: 12h)
LOCAL_JWT_TTL=12h
# First superadmin, created once when the user table is empty (min 10 chars).
# Afterwards manage users in the UI (Benutzer view) or via POST /api/users.
LOCAL_BOOTSTRAP_ADMIN_USER=
LOCAL_BOOTSTRAP_ADMIN_PASSWORD=
# Optional tenant for the bootstrap admin (empty = platform-wide)
LOCAL_BOOTSTRAP_ADMIN_TENANT=

# ── Server ───────────────────────────────────────────────────────────
PORT=8100
APPROVAL_REQUIRED=false

# ── SSRF protection ──────────────────────────────────────────────────
# Comma-separated list of allowed hosts/globs (e.g. *.example.com,api.myservice.com).
# When set, ONLY listed hosts may be connected. When empty, all routable
# targets are allowed except loopback/private/link-local ranges.
# Note: hosts resolving to LAN IPs (e.g. via FritzBox DNS) must be listed here.
SSRF_ALLOWED_HOSTS=
# Home-lab escape hatch: also allow loopback/private/link-local targets.
# Default false. Same effect at runtime via the ssrf.allowPrivateRanges setting.
SSRF_ALLOW_PRIVATE_RANGES=false

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins (default: all origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3030

# ── Connection pool ──────────────────────────────────────────────────
MAX_CONNS_PER_SERVER=20

# ── Runtime tuning (all also changeable live in the UI: Settings view) ─
# Global rate limit (requests/minute/IP)
RATE_LIMIT_MAX=200
# Tool index refresh interval / retry delay (ms), stale cycles until drop
RECONCILE_INTERVAL_MS=60000
RECONCILE_RETRY_MS=5000
RECONCILE_MAX_STALE=10
# Tool retrieval: default and max top-k
SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=20
# Audit feed length
AUDIT_LIMIT=100
# Per-request timeout of the /mcp gateway (ms)
GATEWAY_DISPATCH_TIMEOUT_MS=30000

# ── Decision model (search_tools mode="decision") ─────────────────────
# Opt-in reranker on top of lexical retrieval. Provider 'jev' = TypeSafe AI
# System One (Choice primitive); 'openai-compatible' = any chat-completions
# endpoint (OpenAI, Ollama, OmniRoute, …). All also changeable live in the
# UI: Settings view (the API key is stored AES-256-GCM encrypted there).
DECISION_MODEL_ENABLED=false
DECISION_MODEL_PROVIDER=jev
DECISION_MODEL_BASE_URL=https://openrouter.ai/api/v1
DECISION_MODEL_MODEL=typesafe/jev-1.13
# OpenRouter API key (https://openrouter.ai/settings/keys).
# First-party alternative: base URL https://api.typesafe.ai with a
# TypeSafe console key (https://console.typesafe.ai/keys).
DECISION_MODEL_API_KEY=
# Call timeout (ms) and lexical candidate pool handed to the model
DECISION_MODEL_TIMEOUT_MS=3000
DECISION_MODEL_CANDIDATE_POOL=20
# Force reranking for every search_tools call once a model is configured
DECISION_MODEL_FORCE=false