# ── Required ──────────────────────────────────────────────────────────
# Postgres connection string (omit for in-memory repository)
DATABASE_URL=postgres://optigate:optigate@localhost:5432/mcp_registry

# AES-256-GCM key for encrypting secrets at rest (min 32 chars)
SECRET_ENCRYPTION_KEY=

# ── Auth ─────────────────────────────────────────────────────────────
# Production: Keycloak JWT (RS256/JWKS)
# Dev:       AUTH_MODE=dev  → header-based identity, see README
AUTH_MODE=dev

# Keycloak issuer (only when AUTH_MODE != dev)
KEYCLOAK_URL=
KEYCLOAK_REALM=
# Optional: defaults to realm value
KEYCLOAK_AUDIENCE=

# ── Server ───────────────────────────────────────────────────────────
PORT=8100
APPROVAL_REQUIRED=false

# ── SSRF protection ──────────────────────────────────────────────────
# Comma-separated list of allowed hosts/globs (e.g. *.example.com,api.myservice.com)
# When empty or unset, only well-known internal IPs (127.0.0.1, 169.254.169.254, etc.) are blocked.
# External MCP servers like mcp.tavily.com are always allowed.
SSRF_ALLOWED_HOSTS=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins (default: all origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3030

# ── Connection pool ──────────────────────────────────────────────────
MAX_CONNS_PER_SERVER=20